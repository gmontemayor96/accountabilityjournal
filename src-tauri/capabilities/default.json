{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "dialog:allow-open",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://oauth2.googleapis.com/*"
        },
        {
          "url": "https://www.googleapis.com/*"
        }
      ]
    }
  ]
}
